  "rules": [
    {
      "id": "wx_notice_transfer",
      "channel": "notice",
      "sourceType": "payment_notification",
      "packages": ["com.tencent.mm"],
      "titleWhitelist": ["微信支付", "服务通知"],
      "type": "transfer",
      "regex": "(?:零钱通转入|转入零钱通|零钱通转出|零钱通提现|零钱提现|信用卡还款).*?(?:¥|人民币|金额[:\\s]*)?([\\d,]+(?:\\.\\d{1,2})?)\\s*元?",
      "amountGroup": 1,
      "defaultAccount": "零钱通"
    },
    {
      "id": "wx_notice_income",
      "channel": "notice",
      "sourceType": "payment_notification",
      "packages": ["com.tencent.mm"],
      "titleWhitelist": ["微信支付", "微信收款助手", "服务通知"],
      "type": "income",
      "regex": "(?:收款到账|收款通知|收到(?:\\s*([^\\n,，。;；]{1,20}?)\\s*(?:的)?)?(?:转账|付款|红包)|退款到账|已退款).*?(?:¥|人民币)?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*元?",
      "merchantGroup": 1,
      "amountGroup": 2,
      "defaultAccount": "零钱"
    },
    {
      "id": "wx_notice_expense",
      "channel": "notice",
      "sourceType": "payment_notification",
      "packages": ["com.tencent.mm"],
      "titleWhitelist": ["微信支付", "服务通知"],
      "type": "expense",
      "regex": "(?:向|给)\\s*([^\\n,，。;；()（）]{2,26}?)\\s*(?:付款|支付|消费).*?(?:¥|人民币)?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*元?",
      "merchantGroup": 1,
      "amountGroup": 2,
      "defaultAccount": "微信"
    },
    {
      "id": "wx_notice_expense_generic",
      "channel": "notice",
      "sourceType": "payment_notification",
      "packages": ["com.tencent.mm"],
      "titleWhitelist": ["微信支付", "服务通知"],
      "type": "expense",
      "regex": "(?:微信支付凭证|支付成功|已支付|扣费|扣款|付款金额|支付金额).*?(?:¥|人民币)?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*元?",
      "amountGroup": 1,
      "defaultAccount": "微信"
    },
    {
      "id": "alipay_notice_transfer",
      "channel": "notice",
      "sourceType": "payment_notification",
      "packages": ["com.eg.android.AlipayGphone"],
      "titleWhitelist": ["支付宝", "支付宝通知", "交易提醒", "动账通知", "账单"],
      "type": "transfer",
      "regex": "(?:余额宝转入|转入余额宝|余额宝转出|余额宝提现|余额提现|花呗还款|信用卡还款).*?(?:¥|人民币)?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*元?",
      "amountGroup": 1,
      "defaultAccount": "余额宝"
    },
    {
      "id": "alipay_notice_income",
      "channel": "notice",
      "sourceType": "payment_notification",
      "packages": ["com.eg.android.AlipayGphone"],
      "titleWhitelist": ["支付宝", "支付宝通知", "交易提醒", "动账通知", "收钱码", "账单"],
      "type": "income",
      "regex": "(?:收款|收到|到账|入账|退款|退回).*?(?:¥|人民币)?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*元?",
      "amountGroup": 1,
      "defaultAccount": "账户余额"
    },
    {
      "id": "alipay_notice_expense",
      "channel": "notice",
      "sourceType": "payment_notification",
      "packages": ["com.eg.android.AlipayGphone"],
      "titleWhitelist": ["支付宝", "支付宝通知", "交易提醒", "动账通知", "账单"],
      "type": "expense",
      "regex": "(?:向|在)\\s*([^\\n,，。;；()（）]{2,26}?)\\s*(?:付款|支付|消费).*?(?:¥|人民币)?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*元?",
      "merchantGroup": 1,
      "amountGroup": 2,
      "defaultAccount": "支付宝"
    },
    {
      "id": "alipay_notice_expense_generic",
      "channel": "notice",
      "sourceType": "payment_notification",
      "packages": ["com.eg.android.AlipayGphone"],
      "titleWhitelist": ["支付宝", "支付宝通知", "交易提醒", "动账通知", "账单"],
      "type": "expense",
      "regex": "(?:付款|支付|消费|支出|扣款|扣费|花呗).*?(?:¥|人民币)?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*元?",
      "amountGroup": 1,
      "defaultAccount": "支付宝"
    },
    {
      "id": "bank_notice_transfer",
      "channel": "notice",
      "sourceType": "bank_notification",
      "packages": ["@BANK_PACKAGES"],
      "type": "transfer",
      "regex": "(?:信用卡还款|还信用卡|本人账户互转).*?(?:人民币|RMB|CNY|¥)?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*元?",
      "amountGroup": 1
    },
    {
      "id": "bank_notice_income",
      "channel": "notice",
      "sourceType": "bank_notification",
      "packages": ["@BANK_PACKAGES"],
      "type": "income",
      "regex": "(?:收入|入账|到账|转入|退款|工资|薪资|汇入|存入).*?(?:人民币|RMB|CNY|¥)?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*元?",
      "amountGroup": 1
    },
    {
      "id": "bank_notice_expense",
      "channel": "notice",
      "sourceType": "bank_notification",
      "packages": ["@BANK_PACKAGES"],
      "type": "expense",
      "regex": "(?:消费|支出|付款|支付|扣款|扣费|刷卡|转出|快捷支付|网上支付|代扣).*?(?:人民币|RMB|CNY|¥)?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*元?",
      "amountGroup": 1
    },
    {
      "id": "bank_sms_transfer",
      "channel": "sms",
      "sourceType": "bank_sms",
      "packages": ["@SMS_PACKAGES"],
      "requireBankOrCard": true,
      "type": "transfer",
      "regex": "(?:信用卡还款|还信用卡|自动还款).*?(?:人民币|RMB|CNY|¥)?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*元?",
      "amountGroup": 1
    },
    {
      "id": "bank_sms_income",
      "channel": "sms",
      "sourceType": "bank_sms",
      "packages": ["@SMS_PACKAGES"],
      "requireBankOrCard": true,
      "type": "income",
      "regex": "(?:收入|入账|到账|转入|退款|工资|薪资|汇入|存入).*?(?:人民币|RMB|CNY|¥)?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*元?",
      "amountGroup": 1
    },
    {
      "id": "bank_sms_expense",
      "channel": "sms",
      "sourceType": "bank_sms",
      "packages": ["@SMS_PACKAGES"],
      "requireBankOrCard": true,
      "type": "expense",
      "regex": "(?:消费|支出|付款|支付|扣款|扣费|刷卡|转出|快捷支付|网上支付|代扣|交易).*?(?:人民币|RMB|CNY|¥)?\\s*([\\d,]+(?:\\.\\d{1,2})?)\\s*元?",
      "amountGroup": 1
    },
    {
      "id": "wx_accessibility_pay_success",
      "channel": "accessibility",
      "sourceType": "accessibility_screen",
      "packages": ["com.tencent.mm"],
      "anchors": ["支付成功", "微信支付凭证", "付款方式"],
      "type": "expense",
      "regex": "(?:¥|人民币)\\s*([\\d,]+\\.\\d{2})",
      "amountGroup": 1,
      "defaultAccount": "微信"
    },
    {
      "id": "alipay_accessibility_pay_success",
      "channel": "accessibility",
      "sourceType": "accessibility_screen",
      "packages": ["com.eg.android.AlipayGphone"],
      "anchors": ["支付成功", "付款成功", "交易成功", "付款方式"],
      "type": "expense",
      "regex": "(?:¥|人民币)?\\s*([\\d,]+\\.\\d{2})",
      "amountGroup": 1,
      "defaultAccount": "支付宝"
    }
  ]
}
